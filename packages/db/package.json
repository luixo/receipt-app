{
	"name": "receipt-app-db",
	"version": "0.0.0",
	"type": "module",
	"sideEffects": false,
	"main": "src/index.ts",
	"imports": {
		"#utils/*": "receipt-app-utils/src/*",
		"#app/*": "receipt-app-app/*",
		"#db/*": "./src/*",
		"#db/migration/*": "./migration/*",
		"#tests/backend/*": "receipt-app-vitest/*"
	},
	"scripts": {
		"db:migrate": "bun --bun --env-file=../../.env,../../.env.local kysely migrate latest",
		"db:generate-types": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local generate-types.ts"
	},
	"dependencies": {
		"kysely": "catalog:",
		"kysely-codegen": "^0.20.0",
		"kysely-ctl": "^0.21.0",
		"kysely-plugin-serialize": "^0.8.2",
		"pg": "^8.23.0",
		"receipt-app-utils": "workspace:*"
	},
	"devDependencies": {
		"receipt-app-vitest": "workspace:*",
		"typescript-codegen": "npm:typescript@5.9.3"
	}
}
