{
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"jsx": "react-jsx",
		"module": "esnext",
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"allowImportingTsExtensions": true,
		"allowJs": false,
		"moduleSuffixes": [".web", ""],
		"lib": ["DOM", "ESNext"],
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"target": "ESNext",
		"types": ["node", "bun"],
		"paths": {
			"~app/utils/currency": ["./packages/app/utils/currency"],
			"~db/ids": ["./packages/db/src/ids"]
		}
	},
	"include": ["**/*", ".opencode/**/*", "**/package.json"]
}
