{
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"jsx": "react-jsx",
		"module": "esnext",
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"allowImportingTsExtensions": true,
		"allowJs": false,
		"moduleSuffixes": [".web", ""],
		"lib": ["DOM", "ESNext"],
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"target": "ESNext",
		"types": ["node", "bun"]
	},
	"include": ["**/*", ".opencode/**/*", "**/package.json"]
}
