{
	"name": "receipt-app",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*",
		"testing/*",
		"utils/*"
	],
	"type": "module",
	"scripts": {
		"backend:test": "vitest --configLoader native",
		"ci:cleanup-reports": "bun run --cwd utils/scripts cleanup-ci-reports",
		"db:generate-types": "bun run --cwd packages/db db:generate-types",
		"db:migrate": "bun run --cwd packages/db db:migrate",
		"deps": "knip",
		"dev": "EXPO_PUBLIC_API_BASE_URL=http://localhost:3000 bun run --parallel native:dev web:dev",
		"format": "oxfmt --write",
		"format:verify": "oxfmt --check",
		"frontend:merge-coverage": "bun run --cwd utils/scripts merge-coverage",
		"frontend:test": "bun run --cwd testing/playwright test",
		"install:immutable": "bun install --frozen-lockfile",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"native:dev": "bun --cwd apps/mobile expo start",
		"native:doctor": "bun --cwd apps/mobile expo-doctor",
		"native:prebuild": "bun --cwd apps/mobile expo prebuild",
		"native:run:android": "bun run --cwd apps/mobile css:prepare && bun --cwd apps/mobile expo run:android",
		"native:run:ios": "bun run --cwd apps/mobile css:prepare && bun --cwd apps/mobile expo run:ios",
		"native:update-ios-version": "bun run --cwd apps/mobile update-ios-version",
		"oxiul:verify": "oxiul verify",
		"typecheck": "bun check",
		"verify-routers": "bun run --cwd utils/scripts verify-routers",
		"web:build": "bun run --cwd apps/web build",
		"web:dev": "bun run --cwd apps/web dev",
		"web:start": "bun run --cwd apps/web start",
		"web:start:node": "bun run --cwd apps/web start:node",
		"workflows": "oxiul workflows --verify",
		"workflows:generate": "oxiul workflows --generate"
	},
	"dependencies": {
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-native": "0.86.3",
		"remeda": "^2.25.0"
	},
	"devDependencies": {
		"@opencode/plugin": "^2.0.22",
		"@oxiul/configs": "catalog:",
		"@types/node": "^26.0.0",
		"@types/react": "^19.2.11",
		"@types/react-dom": "^19.2.3",
		"bun-types": "^1.4.3",
		"knip": "^6.42.0",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"cosmiconfig": "^10"
	},
	"engines": {
		"node": "26"
	},
	"packageManager": "bun@1.4.4",
	"catalog": {
		"@oxiul/configs": "0.4.0",
		"@heroui/react": "2.8.4",
		"@playwright/test": "1.63.0",
		"@tanstack/react-query": "5.80.6",
		"@tanstack/react-router": "1.170.16",
		"@tanstack/router-core": "1.171.13",
		"@heroui/theme": "2.4.22",
		"@react-native-vector-icons/lucide": "13.1.4",
		"superjson": "2.2.2",
		"@trpc/client": "11.9.0",
		"@trpc/react-query": "11.9.0",
		"@trpc/server": "11.9.0",
		"@trpc/tanstack-react-query": "11.9.0",
		"cookie": "1.0.2",
		"dataloader": "2.2.2",
		"expo-router": "~57.0.23",
		"heroui-native": "1.0.9",
		"i18next": "25.8.0",
		"image-size": "2.0.2",
		"jimp": "1.6.1",
		"playwright": "1.63.0",
		"kysely": "^0.29.5",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-i18next": "16.5.4",
		"tailwindcss": "4.3.3",
		"tailwind-merge": "3.4.0",
		"@faker-js/faker": "^10.6.0",
		"timekeeper": "^2.3.1",
		"deep-object-diff": "^1.1.9",
		"uniwind": "^1.12.0",
		"uuid": "14.0.2",
		"vite": "^8.2.2",
		"zod": "4.5.4"
	},
	"patchedDependencies": {
		"@heroui/theme@2.4.22": "patches/@heroui-theme-npm-2.4.22.patch",
		"@heroui/toast@2.0.16": "patches/@heroui-toast-npm-2.0.16.patch",
		"@tanstack/query-core@5.80.6": "patches/@tanstack-query-core-npm-5.80.6.patch",
		"@tanstack/react-query@5.80.6": "patches/@tanstack-react-query-npm-5.80.6.patch",
		"@tanstack/start-server-core@1.169.15": "patches/@tanstack-start-server-core-npm-1.169.15.patch",
		"framer-motion@11.11.11": "patches/framer-motion-npm-11.11.11.patch",
		"lucide-react@0.562.0": "patches/lucide-react-npm-0.562.0.patch",
		"react-native-color-matrix-image-filters@8.0.2": "patches/react-native-color-matrix-image-filters-npm-8.0.2.patch",
		"react-native-web@0.21.2": "patches/react-native-web-npm-0.21.2.patch",
		"playwright@1.63.0": "patches/playwright@1.63.0.patch"
	},
	"trustedDependencies": [
		"esbuild",
		"@oxiul/configs"
	]
}
